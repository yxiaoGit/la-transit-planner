{
  "name": "la-transit-planner",
  "version": "1.0.0",
  "private": true,
  "description": "LA County bus trip planner \u2014 offline fixture mode for sandboxes, OTP mode for AWS",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "otp:download": "bash otp/scripts/download-data.sh",
    "otp:up": "docker compose -f otp/docker-compose.yml up",
    "otp:down": "docker compose -f otp/docker-compose.yml down"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.14",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "resolve": "1.22.13",
    "is-core-module": "2.17.0",
    "source-map-js": "1.2.2",
    "electron-to-chromium": "1.5.477",
    "node-releases": "2.0.63",
    "csstype": "3.2.3",
    "baseline-browser-mapping": "2.11.35",
    "browserslist": "4.29.5",
    "update-browserslist-db": "1.3.4",
    "caniuse-lite": "1.0.30001822",
    "@jridgewell/resolve-uri": "3.1.2",
    "graceful-fs": "4.2.11",
    "lilconfig": "3.1.4",
    "postcss-selector-parser": "6.1.5"
  }
}
